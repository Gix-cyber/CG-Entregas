# Cubo 3D no formato exportado pelo Blender (faces "f" c indices v/vt/vn)
# todas as arestas das faces viram um unico objeto 3D (modelo de arame) no SGI
mtllib teste.mtl

o Cube
usemtl azul
v 100.0 100.0 -100.0
v 100.0 -100.0 -100.0
v 100.0 100.0 100.0
v 100.0 -100.0 100.0
v -100.0 100.0 -100.0
v -100.0 -100.0 -100.0
v -100.0 100.0 100.0
v -100.0 -100.0 100.0
vn 0.0 1.0 0.0
s off
f 1/1/1 5/2/1 7/3/1 3/4/1
f 4/5/2 3/4/2 7/6/2 8/7/2
f 8/8/3 7/9/3 5/10/3 6/11/3
f 6/12/4 2/13/4 4/5/4 8/14/4
f 2/13/5 1/1/5 3/4/5 4/5/5
f 6/11/6 5/10/6 1/1/6 2/13/6

o chao
usemtl verde
v -200 -200 -100
v 200 -200 -100
v 200 200 -100
v -200 200 -100
l 9 10 11 12 9
